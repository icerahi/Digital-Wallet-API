{
  "info": {
    "name": "Digital Wallet API",
    "description": "Postman Collection for Digital Wallet API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullname\": \"Imran Hasan\",\n  \"phone\": \"01799999999\",\n  \"password\": \"Pass@123\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/users/register",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "users",
                "register"
              ]
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"01799999999\",\n  \"password\": \"Pass@123\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/auth/login",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Wallet",
      "item": [
        {
          "name": "Get My Wallet",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{YOUR_TOKEN_HERE}}"
              }
            ],
            "url": {
              "raw": "http://localhost:5000/api/v1/wallets/me",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "wallets",
                "me"
              ]
            }
          }
        },
        {
          "name": "Send Money (P2P)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{YOUR_TOKEN_HERE}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver\": \"01999999999\",\n  \"amount\": 25\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/wallets/send-money",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "wallets",
                "send-money"
              ]
            }
          }
        },
        {
          "name": "Agent Cash-In",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{AGENT_TOKEN_HERE}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"receiver\": \"01799999999\",\n  \"amount\": 500\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/v1/wallets/cash-in",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5000",
              "path": [
                "api",
                "v1",
                "wallets",
                "cash-in"
              ]
            }
          }
        }
      ]
    },
